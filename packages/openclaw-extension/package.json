{
  "name": "@kyan-du/agent-wechat-openclaw",
  "version": "0.13.3",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "!dist/.release-metafile.json"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --metafile=dist/.release-metafile.json --external:openclaw --external:sharp",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@kyan-du/agent-wechat-shared": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "openclaw": "^2026.5.12",
    "typescript": "^5.4.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "agent-wechat",
      "label": "WeChat",
      "selectionLabel": "WeChat (agent-wechat)",
      "aliases": [],
      "order": 80
    },
    "install": {
      "npmSpec": "@kyan-du/agent-wechat-openclaw"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyan-du/agent-wechat.git",
    "directory": "packages/openclaw-extension"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
