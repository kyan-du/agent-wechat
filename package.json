{
  "name": "agent-wechat",
  "version": "0.1.0",
  "description": "WeChat automation via deterministic FSM",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo watch build",
    "typecheck": "turbo run typecheck",
    "test:release-boundary": "node scripts/validate-release-boundary.mjs",
    "test:release-inputs": "node scripts/validate-release-inputs.mjs && node scripts/test-release-inputs.mjs",
    "test:root-cli-image": "node --test --experimental-strip-types src/lib/image.test.mts",
    "download:wechat": "bash scripts/download-wechat.sh",
    "build:image": "bash scripts/build-images-local.sh",
    "build:image:arm64": "bash scripts/build-images-local.sh --arch arm64",
    "build:image:amd64": "bash scripts/build-images-local.sh --arch amd64",
    "build:image:all": "bash scripts/build-images-local.sh --arch both",
    "cli": "node packages/cli/dist/cli.js",
    "db": "docker cp agent-wechat:/data/agent.db /tmp/agent.db && docker cp agent-wechat:/data/agent.db-wal /tmp/agent.db-wal 2>/dev/null; docker cp agent-wechat:/data/agent.db-shm /tmp/agent.db-shm 2>/dev/null; sqlite3 -header -column /tmp/agent.db",
    "dev": "bash scripts/dev.sh",
    "dev:watch": "bash scripts/dev-watch.sh",
    "dev:deploy": "bash scripts/dev-deploy.sh",
    "dev:check": "cd packages/agent-server-rust && cargo watch -x check",
    "generate-types": "bash scripts/generate-types.sh",
    "gateway": "pnpm --filter @kyan-du/agent-wechat-wechaty-gateway exec -- node --import tsx src/main.ts",
    "gateway:test": "pnpm --filter @kyan-du/agent-wechat-wechaty-gateway exec -- node --import tsx scripts/test-gateway.ts",
    "gateway:test:remote": "pnpm --filter @kyan-du/agent-wechat-wechaty-gateway exec -- node --import tsx scripts/test-gateway-remote.ts",
    "version-packages": "pnpm changeset version && bash scripts/sync-cargo-version.sh && pnpm install --lockfile-only",
    "prepare:openclaw-plugin": "node scripts/prepare-openclaw-plugin.mjs",
    "validate:prerelease": "bash scripts/validate-prerelease.sh",
    "test:prerelease-contract": "bash scripts/test-prerelease-contract.sh",
    "test:prerelease-manifest": "bash scripts/test-prerelease-manifest.sh",
    "test:npm-packages": "node scripts/smoke-npm-packages.mjs",
    "test:ghcr-release": "node scripts/validate-ghcr-release.mjs && node scripts/test-ghcr-release.mjs",
    "test:release-plan": "node --test scripts/agent-release.test.mjs scripts/release-authorization.test.mjs scripts/release-reconciliation.test.mjs scripts/reconcile-npm-release.test.mjs scripts/select-npm-release-artifacts.test.mjs",
    "test:release-workflows": "node scripts/test-agent-release-workflows.mjs && node scripts/test-tag-release-workflow.mjs && node scripts/test-release-crash-matrix.mjs",
    "prepare:release-pr": "node scripts/prepare-release-pr.mjs",
    "prepare:release-candidate": "node scripts/prepare-agent-release.mjs",
    "verify:release-candidate": "node scripts/verify-agent-release.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "turbo": "^2.4.4",
    "typescript": "^5.4.5",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4"
}
